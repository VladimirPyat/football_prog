NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DEFAULT_CONTEST_ID=1

# ── Datetime (supervisor UI) ───────────────────────────────────────────────
# Storage/API: always UTC (must match backend TIMESTAMPTZ policy).
NEXT_PUBLIC_API_TIMESTAMP_TIMEZONE=UTC

# Display + datetime-local inputs (IANA). Omit to use the browser's local zone.
NEXT_PUBLIC_DISPLAY_TIMEZONE=Europe/Moscow

# Optional: ru-RU date/time labels (default ru-RU)
# NEXT_PUBLIC_DATETIME_LOCALE=ru-RU

# delete after testing
E2E_SUPERVISOR_PASSWORD=test
# Support role login (bootstrap login `admin` until SEED_SUPPORT_LOGIN changed)
E2E_SUPPORT_PASSWORD=test