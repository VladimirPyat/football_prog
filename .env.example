# Copy to `.env` in the project root and fill in real values.
# `.env` is gitignored — never commit secrets.

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./football.db

# ─── JWT (required in production) ───────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Bootstrap: ADMIN user (src/scripts/bootstrap_users.py) ─────────────────
# Plaintext password is hashed by the script at runtime (bcrypt, no separate key).
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=your-admin-password-here
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

# Alternative: store a precomputed bcrypt hash instead of plaintext.
# Generate from your real password (run once locally, paste output here):
#   uv run python src/scripts/hash_password.py 'your-password'
# Or: PYTHONPATH=src uv run python -c "from core.security import hash_password; print(hash_password('your-password'))"
# SEED_ADMIN_PASSWORD_HASH=$2b$12$...

# ─── Bootstrap: organizer / SUPERVISOR (optional; comment out in script later) ─
SEED_SUPERVISOR_LOGIN=supervisor
SEED_SUPERVISOR_PASSWORD=your-supervisor-password-here
SEED_SUPERVISOR_FIRST_NAME=Supervisor
SEED_SUPERVISOR_LAST_NAME=User
# Or: SEED_SUPERVISOR_PASSWORD_HASH=$2b$12$...

# ─── Contest lifecycle (optional) ─────────────────────────────────────────────
# CONTEST_DELETE_GRACE_SECONDS=10
# CONTEST_DELETE_ENABLED=true
# CONTEST_ALLOW_INSTANT_DELETE=false

# ─── HTTP cache & logging (optional) ────────────────────────────────────────
# CACHE_MAX_AGE_SECONDS=300
# CACHE_STALE_WHILE_REVALIDATE_SECONDS=60
# LOG_LEVEL=INFO

# ─── CORS (optional, JSON list) ─────────────────────────────────────────────
# CORS_ORIGINS=["*"]
