# ─────────────────────────────────────────────────────────────────────────────
# Secrets & deployment — copy to `.env` in the project root (gitignored).
#
# Source of truth for all other defaults: config/settings.py
# Full reference: manuals/setup/CONFIG.md
# Docker deploy: manuals/setup/DEPLOYMENT.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployment mode ───────────────────────────────────────────────────────────
# local     — laptop dev (SQLite, CORS *, localhost URLs)
# web_dev   — server/docker staging (SQLite in ./data/football.db)
# web_prod  — production server (PostgreSQL, HTTPS public URLs)
APP_MODE=local

# Public URLs — set on the server for web_dev / web_prod (survives git pull).
# With nginx on :80 (single host): both URLs = http://YOUR_IP (no port).
# See deploy/ and manuals/setup/DEPLOYMENT.md
# PUBLIC_FRONTEND_URL=http://10.0.0.1
# PUBLIC_API_URL=http://10.0.0.1

# ── Secrets ───────────────────────────────────────────────────────────────────

# Database (local: SQLite default; web_*: compose sets PostgreSQL URL automatically)
DATABASE_URL=sqlite+aiosqlite:///./football.db

# PostgreSQL password for docker-compose `db` service (web_dev / web_prod)
# POSTGRES_PASSWORD=change-me-strong-db-password

# JWT signing key — change before production
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Bootstrap passwords (src/scripts/bootstrap_users.py)
# Logins and display names are in config/settings.py (support / supervisor).
SEED_SUPPORT_PASSWORD=your-support-password-here
SEED_SUPERVISOR_PASSWORD=your-supervisor-password-here

# Datetime storage policy (must stay UTC; see manuals/setup/CONFIG.md § Datetime policy)
# API_TIMESTAMP_TIMEZONE=UTC

# Frontend datetime display — see frontend/.env.local.example (NEXT_PUBLIC_DISPLAY_TIMEZONE)

# Optional docker-compose host port overrides (defaults 8000 / 3000)
# API_PORT=8000
# FRONTEND_PORT=3000

# Alternative: precomputed bcrypt hash instead of plaintext password
#   uv run python src/scripts/hash_password.py 'your-password'
# SEED_SUPPORT_PASSWORD_HASH=
# SEED_SUPERVISOR_PASSWORD_HASH=
