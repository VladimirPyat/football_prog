# ─────────────────────────────────────────────────────────────────────────────
# Secrets & deployment — copy to `.env` in the project root (gitignored).
#
# Source of truth for all other defaults: config/settings.py
# Full reference: manuals/CONFIG.md
# ─────────────────────────────────────────────────────────────────────────────

# Database (use PostgreSQL URL in production)
DATABASE_URL=sqlite+aiosqlite:///./football.db

# JWT signing key — change before production
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Bootstrap passwords (src/scripts/bootstrap_users.py)
# Logins and display names are in config/settings.py (admin / supervisor).
SEED_ADMIN_PASSWORD=your-admin-password-here
SEED_SUPERVISOR_PASSWORD=your-supervisor-password-here

# Demo participant for dev/E2E (bootstrap_users.py) — TEMPORARY until 2.3 invite UI
# Defaults in config/settings.py work without setting these (login=user, password=user).
# SEED_DEMO_USER_LOGIN=user
# SEED_DEMO_USER_PASSWORD=user

# ── Stage 1.12: auth links & supervisor training (local dev / E2E) ───────────
# ENFORCE_PASSWORD_SETUP=false
# SUPERVISOR_TRAINING_MODE=true
# CONTEST_DELETE_GRACE_SECONDS=0
# CONTEST_RESTORE_WINDOW_SECONDS=86400
# FRONTEND_BASE_URL=http://127.0.0.1:3000
# SETUP_TOKEN_EXPIRE_HOURS=72

# Alternative: precomputed bcrypt hash instead of plaintext password
#   uv run python src/scripts/hash_password.py 'your-password'
# SEED_ADMIN_PASSWORD_HASH=
# SEED_SUPERVISOR_PASSWORD_HASH=
